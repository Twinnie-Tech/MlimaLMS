DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=

# Email (OTP codes). Uses Resend when RESEND_API_KEY is set and falls back to Gmail SMTP if Resend fails.
EMAIL_FROM_NAME=MlimaLMS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM=you@gmail.com
# Gmail app password: Google Account > Security > 2-Step Verification > App passwords
SMTP_PASS=
RESEND_API_KEY=
# onboarding@resend.dev until you verify a domain in Resend, then e.g. no-reply@mlimalms.com
RESEND_FROM=onboarding@resend.dev

# AWS S3 storage for course videos and cover images (see docs/s3-setup.md)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# Optional: CloudFront or custom domain in front of the bucket, e.g. https://cdn.mlimalms.com
AWS_S3_PUBLIC_URL=

# Arcjet security (rate limiting, bot detection, email validation). Get a key at https://app.arcjet.com (starts with aj)
ARCJET_KEY=
